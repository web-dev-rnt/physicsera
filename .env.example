# Copy to .env for local development, or set these as Railway service variables.

# Set to True only for local development.
DEBUG=False

# Comma-separated list of allowed hosts (Railway sets RAILWAY_PUBLIC_DOMAIN automatically).
ALLOWED_HOSTS=

# Comma-separated list of trusted origins for CSRF (e.g. https://your-app.up.railway.app).
CSRF_TRUSTED_ORIGINS=

# A strong, random secret key for production.
SECRET_KEY=

# Provided automatically by Railway's Postgres plugin. Falls back to local sqlite if unset.
DATABASE_URL=
